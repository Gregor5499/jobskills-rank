# Vorlage fuer die benoetigten Umgebungsvariablen.
# Werte eintragen und im Terminal laden, z. B. mit:  set -a; source .env; set +a
# Die echte .env-Datei wird von Git ignoriert und niemals hochgeladen.

# Adzuna Jobs API (kostenlos: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Gemini API (kostenlos: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: Bezugsadresse fuer die Entfernungsberechnung (Python-Version)
# HOME_ADDRESS="Musterstr. 1, 10115 Berlin"
